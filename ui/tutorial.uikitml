<view name="root" flexDirection="column" alignItems="center" padding="20" backgroundColor="#000a14" opacity="0.95" borderRadius="16" width="500" height="700">
  <text name="title" fontSize="28" color="#00ffff" fontWeight="bold">HOW TO PLAY</text>
  <text name="line1" fontSize="13" color="#ccddee" marginTop="12">Hop on cubes to change their color.</text>
  <text name="line2" fontSize="13" color="#ccddee" marginTop="4">Change ALL cubes to win the round!</text>
  <text name="line2b" fontSize="12" color="#ff8800" marginTop="4">Later rounds need multiple hops per cube.</text>
  <text name="line3" fontSize="13" color="#448888" marginTop="10">-- KEYBOARD CONTROLS --</text>
  <text name="line4" fontSize="12" color="#aacccc" marginTop="4">Q = Up-Left    E = Up-Right</text>
  <text name="line5" fontSize="12" color="#aacccc" marginTop="3">A = Down-Left  D = Down-Right</text>
  <text name="line6" fontSize="12" color="#aacccc" marginTop="3">ESC / P = Pause</text>
  <text name="line7" fontSize="13" color="#448888" marginTop="10">-- VR CONTROLS --</text>
  <text name="line8" fontSize="12" color="#aacccc" marginTop="4">Thumbstick = Hop direction</text>
  <text name="line9" fontSize="12" color="#aacccc" marginTop="3">B Button = Pause</text>
  <text name="line10" fontSize="13" color="#448888" marginTop="10">-- ENEMIES --</text>
  <text name="line11" fontSize="11" color="#aa88ff" marginTop="4">Coily (purple): Chases you!</text>
  <text name="line12" fontSize="11" color="#44ff88" marginTop="3">Slick/Sam (green/blue): Revert cubes</text>
  <text name="line12b" fontSize="11" color="#ff6600" marginTop="3">Ugg (orange): Moves sideways</text>
  <text name="line12c" fontSize="11" color="#ff0066" marginTop="3">Wrongway (pink): Moves sideways</text>
  <text name="line13" fontSize="13" color="#448888" marginTop="10">-- POWER-UPS --</text>
  <text name="line14a" fontSize="11" color="#4488ff" marginTop="4">Shield: Absorbs one hit</text>
  <text name="line14b" fontSize="11" color="#ffcc00" marginTop="3">Score Boost: 2x points</text>
  <text name="line14c" fontSize="11" color="#88ffff" marginTop="3">Freeze: Stops all enemies</text>
  <text name="line15" fontSize="13" color="#448888" marginTop="10">-- FLYING DISCS --</text>
  <text name="line16" fontSize="11" color="#ff8800" marginTop="4">Orange platforms at edges. Hop to</text>
  <text name="line17" fontSize="11" color="#ff8800" marginTop="3">teleport to top. Coily falls off!</text>
  <text name="btn-back" fontSize="18" color="#aacccc" backgroundColor="#112233" padding="10" borderRadius="8" marginTop="15" cursor="pointer">BACK</text>
</view>

<view name="root" flexDirection="column" alignItems="center" padding="25" backgroundColor="#000a14" opacity="0.95" borderRadius="16" width="450" height="600">
  <text name="title" fontSize="28" color="#00ffff" fontWeight="bold">SETTINGS</text>
  <text name="section-audio" fontSize="14" color="#448888" marginTop="15">-- AUDIO --</text>
  <text name="btn-sound" fontSize="16" color="#ffffff" backgroundColor="#223344" padding="10" borderRadius="6" marginTop="8" cursor="pointer">Sound: ON</text>
  <text name="btn-music" fontSize="16" color="#ffffff" backgroundColor="#223344" padding="10" borderRadius="6" marginTop="6" cursor="pointer">Music: ON</text>
  <text name="section-theme" fontSize="14" color="#448888" marginTop="15">-- COLOR THEME --</text>
  <text name="scheme-val" fontSize="12" color="#88aacc" marginTop="5">Theme: CYAN</text>
  <view flexDirection="row" marginTop="8" gap="8">
    <text name="btn-cyan" fontSize="12" color="#00ffff" backgroundColor="#003333" padding="8" borderRadius="6" cursor="pointer">CYAN</text>
    <text name="btn-green" fontSize="12" color="#00ff88" backgroundColor="#002211" padding="8" borderRadius="6" cursor="pointer">GREEN</text>
    <text name="btn-magenta" fontSize="12" color="#ff00ff" backgroundColor="#330033" padding="8" borderRadius="6" cursor="pointer">MAGENTA</text>
    <text name="btn-gold" fontSize="12" color="#ffcc00" backgroundColor="#332200" padding="8" borderRadius="6" cursor="pointer">GOLD</text>
  </view>
  <text name="section-diff" fontSize="14" color="#448888" marginTop="15">-- DIFFICULTY --</text>
  <text name="difficulty-val" fontSize="12" color="#88aacc" marginTop="5">Difficulty: MEDIUM</text>
  <view flexDirection="row" marginTop="8" gap="8">
    <text name="btn-easy" fontSize="14" color="#00ff88" backgroundColor="#002211" padding="8" borderRadius="6" cursor="pointer">EASY</text>
    <text name="btn-medium" fontSize="14" color="#ffcc00" backgroundColor="#332200" padding="8" borderRadius="6" cursor="pointer">MEDIUM</text>
    <text name="btn-hard" fontSize="14" color="#ff4444" backgroundColor="#330000" padding="8" borderRadius="6" cursor="pointer">HARD</text>
  </view>
  <text name="btn-back" fontSize="18" color="#aacccc" backgroundColor="#112233" padding="10" borderRadius="8" marginTop="20" cursor="pointer">BACK</text>
</view>

<view name="root" flexDirection="column" alignItems="center" justifyContent="center" padding="30" backgroundColor="#000a14" opacity="0.95" borderRadius="16" width="450" height="450">
  <text name="result-title" fontSize="32" color="#00ffff" fontWeight="bold">GAME OVER</text>
  <text name="result-score" fontSize="20" color="#ffffff" marginTop="15">Score: 0</text>
  <text name="result-round" fontSize="16" color="#aacccc" marginTop="8">Round: 1</text>
  <text name="result-hops" fontSize="16" color="#aacccc" marginTop="8">Total Hops: 0</text>
  <text name="result-high" fontSize="16" color="#ffcc00" marginTop="8">High Score: 0</text>
  <text name="btn-again" fontSize="22" color="#00ffcc" backgroundColor="#003333" padding="12" borderRadius="8" marginTop="25" cursor="pointer">PLAY AGAIN</text>
  <text name="btn-menu" fontSize="18" color="#aacccc" backgroundColor="#112233" padding="10" borderRadius="8" marginTop="10" cursor="pointer">MAIN MENU</text>
</view>
